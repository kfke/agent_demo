# Copy this file to .env and fill in real secrets locally.
# .env is ignored by Git and must not be committed.

# Required only when using --openai or OPENAI_MODEL=openai/...
OPENAI_API_KEY=

# Default live model used by `python demo.py --openai` and Docker's nda-guard-openai service.
OPENAI_MODEL=openai/gpt-4.1-mini

# Optional LiteLLM/OpenAI-compatible settings.
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_ORG_ID=

# Recommended on Windows and harmless in Linux containers.
PYTHONUTF8=1

# For ADK Web debug/event logs. Use cautiously because prompts/tool data are sensitive.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
